# Copy to .env and run chmod 600 .env. Never commit .env.
# One-time Tailscale auth key (console: Settings > Keys). Only needed for the first start.
TS_AUTHKEY=
# Subnet of the compose network (docker network inspect pandafit_default); empty falls back to 172.16.0.0/12.
PANDAFIT_TRUST_PROXY_CIDR=
# Host port on 127.0.0.1; compare with the port table in ~/SERVER.md. Empty means 7004.
PANDAFIT_PORT=
# Push notifications: contact for the push services (mailto:... or https://...); empty means the app's public origin.
PANDAFIT_PUSH_SUBJECT=
# off sends no push notifications at all; empty means on.
PANDAFIT_PUSH=
