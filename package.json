{
  "name": "bike-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:sim": "BIKE_SIM=1 electron-vite dev",
    "build": "electron-vite build",
    "probe": "tsx scripts/ble-probe.ts",
    "test": "vitest run --exclude 'tests/chaos/**'",
    "test:chaos": "vitest run tests/chaos",
    "test:garmin": "python3 -m unittest discover -s scripts/garmin",
    "typecheck": "tsc --noEmit",
    "coach:check": "tsx scripts/coach-check.ts",
    "ui:shots": "tsx scripts/ui-shots/run.ts",
    "live:adjust": "tsx scripts/live-adjust.ts",
    "live:mark": "tsx scripts/live-mark.ts",
    "live:undo": "tsx scripts/live-undo.ts"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.218.0",
    "@stoprocent/noble": "^2.8.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@stoprocent/noble@2.8.0": true,
    "@stoprocent/bluetooth-hci-socket@2.3.0": true,
    "usb@2.19.1": true,
    "esbuild@0.28.2": true,
    "@serialport/bindings-cpp@12.0.1": true
  }
}
